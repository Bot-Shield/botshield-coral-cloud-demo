<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>BotShield Booking Access</label>
    <description>Grants the Apex entry point for the BotShield-gated Book Now flow on the Coral Cloud site. Assign to the site guest user and any test users.</description>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>BotShield_Cancel_Booking_With_Refund</flow>
    </flowAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>CoralCancelBookingAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CoralRefundStatusAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CoralMyBookingsAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BotShieldBookingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BotShieldCensusCheckout</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
